# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vehicle_rental_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# CORS & Frontend URL
CLIENT_URL=http://localhost:3000
